# ============================================================================
# ⚠️  IMPORTANT SECURITY WARNING
# ============================================================================
# This is an EXAMPLE configuration file with PLACEHOLDER keys.
# You MUST replace ALL private keys with your REAL private keys before use!
# DO NOT use the example keys in production - they are for demonstration only.
# ============================================================================

# Rust related
RUST_LOG=info,sqlx::query=warn

#############################################################
#                       ENV                                 #
#           local, dev, signet, testnet4, mainnet           #
#############################################################
BITVM_BRIDGE_ENVIRONMENT=signet

#############################################################
#                   Configuration Path                      #
#############################################################
# Set this environment variable when starting the operator:
# export FIAMMA_MONO_CONFIG_PATH=./
# This tells the operator to load .env from current directory

#############################################################
#                   Operator configuration                  #
#############################################################

# Option 1: Plaintext Private Keys (for testing environments)
# Uncomment and set your actual private keys:
# ⚠️  WARNING: Replace with your REAL private keys, these are just examples!
# BITVM_BRIDGE_OPERATOR_AUTH_SK=L1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef12
# BITVM_BRIDGE_OPERATOR_PEGIN_SK=L2234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef23
# BITVM_BRIDGE_OPERATOR_PEGOUT_SK=L3234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef34

# Option 2: GPG Encrypted Private Keys (recommended for production)
# To use GPG encrypted keys:
# 1. Run: ./bcli encode -i your_keys_file.env -o .env
# 2. Uncomment the line below to enable GPG mode
# 3. Replace the example encrypted keys with your actual encrypted keys

BITVM_BRIDGE_USE_GPG_KEYS=1

# ⚠️  WARNING: These are EXAMPLE encrypted keys. Replace with your REAL encrypted keys!
# Use: ./bcli encode -i your_real_keys.env -o .env

## Operator secret key, use for authorization (GPG encrypted, base64 format)
BITVM_BRIDGE_OPERATOR_AUTH_SK="EXAMPLE_BASE64_ENCRYPTED_AUTH_KEY_REPLACE_WITH_YOUR_REAL_ENCRYPTED_KEY"

## Operator pegin secret key, use for pegin action (GPG encrypted, base64 format)
BITVM_BRIDGE_OPERATOR_PEGIN_SK="EXAMPLE_BASE64_ENCRYPTED_PEGIN_KEY_REPLACE_WITH_YOUR_REAL_ENCRYPTED_KEY"

## Operator pegout secret key, use for pegout action (GPG encrypted, base64 format)
BITVM_BRIDGE_OPERATOR_PEGOUT_SK="EXAMPLE_BASE64_ENCRYPTED_PEGOUT_KEY_REPLACE_WITH_YOUR_REAL_ENCRYPTED_KEY"

# Note: These are EXAMPLE encrypted keys. You MUST replace them with your actual encrypted keys.
# Generate real encrypted keys using: ./bcli encode -i your_plaintext_keys.env -o .env
# When starting the operator, you'll be prompted: 🔐 Enter GPG decryption password: