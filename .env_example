# Rust related
RUST_LOG=info,sqlx::query=warn

#############################################################
#                       ENV                                 #
#           local, dev, signet, testnet4, mainnet           #
#############################################################
BITVM_BRIDGE_ENVIRONMENT=mainnet

#############################################################
#                   Operator configuration                  #
#############################################################
## Operator secret key, use for authorization
BITVM_BRIDGE_OPERATOR_AUTH_SK=
## Operator pegin secret key, use for pegin action
BITVM_BRIDGE_OPERATOR_PEGIN_SK=
## Operator pegout secret key, use for pegout action
BITVM_BRIDGE_OPERATOR_PEGOUT_SK=
## Operator evm secret key, used for stake FiaBTC
BITVM_BRIDGE_OPERATOR_ETH_SK=

#  optional to set, for better RPC stability
# Aptos
BITVM_BRIDGE_OPERATOR_APTOS_SK=
BITVM_BRIDGE_OPERATOR_APTOS_API_KEY=

# # Solana
# BITVM_BRIDGE_OPERATOR_SOLANA_SK=

# # Babylon
# BITVM_BRIDGE_OPERATOR_BABYLON_SK=